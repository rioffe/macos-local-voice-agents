# ---------------------------------------------------------------------------
# Bot configuration. Every value has a built-in default, so running with no
# file at all reproduces the original behaviour. Set any variable here (or pass
# the matching --flag at the command line) to override. Precedence:
#       command-line flags  >  environment / .env  >  built-in default.
#
# See the top of server/config.py for the full list and descriptions, and the
# "Configuration" section of README.md for examples.
# ---------------------------------------------------------------------------

# --- HTTP server ---
#BOT_HOST=localhost
#BOT_PORT=7860

# --- LLM (OpenAI-compatible; Ollama by default) ---
#LLM_MODEL=gemma3n:e4b
#LLM_BASE_URL=http://127.0.0.1:11434/v1
#LLM_API_KEY=dummyKey            # Ollama ignores this; required by the constructor
#LLM_MAX_TOKENS=4096

# --- STT (MLX Whisper). Any mlx-community repo id, or an MLXModel name. ---
#STT_MODEL=mlx-community/whisper-large-v3-turbo-q4

# --- TTS (isolated subprocess; Kokoro or Marvis, auto-picked by model name). ---
#TTS_MODEL=mlx-community/Kokoro-82M-bf16
#TTS_VOICE=af_heart             # Kokoro voice id (ignored by the Marvis worker)
#TTS_SAMPLE_RATE=24000

# --- VAD / turn detection ---
#VAD_STOP_SECS=0.2             # seconds of silence that end a turn
#SMART_TURN_MODEL=             # "" => download the end-of-turn model from Hugging Face

# --- Conversation prompt. Use the inline text OR a file (file wins if both set). ---
#SYSTEM_PROMPT=
#SYSTEM_PROMPT_FILE=../prompts/bella.txt   # "Bella", the flirty voice assistant

# --- Misc ---
#AGGREGATION_TIMEOUT=0.05      # user transcript coalescence timeout (Whisper is non-streaming)
#ICE_SERVERS=stun:stun.l.google.com:19302
#ENABLE_METRICS=true
#ENABLE_USAGE_METRICS=true

# ---------------------------------------------------------------------------
# Legacy placeholders kept from the upstream Pipecat template. Only Ollama's
# endpoint is used by this bot (via the LLM_* vars above); these are inert but
# kept so the template stays recognizable.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""
DEEPGRAM_API_KEY=""
RIME_API_KEY=""
